# Smartelligent Container Configuration
# This file controls which containers use custom repositories vs standard ones

# Main components (always custom from Digital-Synapse-SA)
# Format: REPO_URL#BRANCH_NAME
SMARTELLIGENT_CORE_REPO="https://github.com/Digital-Synapse-SA/core.git#main"
SMARTELLIGENT_FRONTEND_REPO="https://github.com/Digital-Synapse-SA/frontend.git#main"
SMARTELLIGENT_SUPERVISOR_REPO="https://github.com/Digital-Synapse-SA/supervisor.git#main"

# Supporting components (configurable)
# Set to "y" to use custom repository, "n" to use standard container

# DNS service (dnsmasq)
SMARTELLIGENT_USE_CUSTOM_DNS="y"
SMARTELLIGENT_DNS_REPO="https://github.com/Digital-Synapse-SA/dns.git#main"

# Audio service (PulseAudio)
SMARTELLIGENT_USE_CUSTOM_AUDIO="y"
SMARTELLIGENT_AUDIO_REPO="https://github.com/Digital-Synapse-SA/audio.git#main"

# CLI tools
SMARTELLIGENT_USE_CUSTOM_CLI="y"
SMARTELLIGENT_CLI_REPO="https://github.com/Digital-Synapse-SA/cli.git#main"

# Multicast discovery (Avahi)
SMARTELLIGENT_USE_CUSTOM_MULTICAST="y"
SMARTELLIGENT_MULTICAST_REPO="https://github.com/Digital-Synapse-SA/multicast.git#main"

# System monitoring (Observer)
SMARTELLIGENT_USE_CUSTOM_OBSERVER="y"
SMARTELLIGENT_OBSERVER_REPO="https://github.com/Digital-Synapse-SA/observer.git#main"

# Branch Configuration Examples:
# 
# Development:
# SMARTELLIGENT_CORE_REPO="https://github.com/Digital-Synapse-SA/core.git#smartelligent-core-dev"
# SMARTELLIGENT_FRONTEND_REPO="https://github.com/Digital-Synapse-SA/frontend.git#smartelligent-frontend-dev"
# SMARTELLIGENT_SUPERVISOR_REPO="https://github.com/Digital-Synapse-SA/supervisor.git#smartelligent-supervisor-dev"
#
# Release:
# SMARTELLIGENT_CORE_REPO="https://github.com/Digital-Synapse-SA/core.git#smartelligent-core-v1.0.0"
# SMARTELLIGENT_FRONTEND_REPO="https://github.com/Digital-Synapse-SA/frontend.git#smartelligent-frontend-v1.0.0"
# SMARTELLIGENT_SUPERVISOR_REPO="https://github.com/Digital-Synapse-SA/supervisor.git#smartelligent-supervisor-v1.0.0"
#
# Feature branches:
# SMARTELLIGENT_CORE_REPO="https://github.com/Digital-Synapse-SA/core.git#smartelligent-core-feature/new-branding"
# SMARTELLIGENT_FRONTEND_REPO="https://github.com/Digital-Synapse-SA/frontend.git#smartelligent-frontend-feature/new-ui"
# SMARTELLIGENT_SUPERVISOR_REPO="https://github.com/Digital-Synapse-SA/supervisor.git#smartelligent-supervisor-feature/custom-management"

# Fallback behavior
# If a custom repository fails to build, the system will:
# 1. Try to build a standard container with Smartelligent branding
# 2. If that fails, fall back to official Home Assistant container
# 3. Log the failure for debugging

# Example configurations:

# Full custom (all containers from your repos):
# SMARTELLIGENT_USE_CUSTOM_DNS="y"
# SMARTELLIGENT_USE_CUSTOM_AUDIO="y"
# SMARTELLIGENT_USE_CUSTOM_CLI="y"
# SMARTELLIGENT_USE_CUSTOM_MULTICAST="y"
# SMARTELLIGENT_USE_CUSTOM_OBSERVER="y"

# Hybrid (main components custom, supporting components standard):
# SMARTELLIGENT_USE_CUSTOM_DNS="n"
# SMARTELLIGENT_USE_CUSTOM_AUDIO="n"
# SMARTELLIGENT_USE_CUSTOM_CLI="n"
# SMARTELLIGENT_USE_CUSTOM_MULTICAST="n"
# SMARTELLIGENT_USE_CUSTOM_OBSERVER="n"

# Selective (choose which ones to customize):
# SMARTELLIGENT_USE_CUSTOM_DNS="y"      # Custom DNS
# SMARTELLIGENT_USE_CUSTOM_AUDIO="n"    # Standard audio
# SMARTELLIGENT_USE_CUSTOM_CLI="y"      # Custom CLI
# SMARTELLIGENT_USE_CUSTOM_MULTICAST="n" # Standard multicast
# SMARTELLIGENT_USE_CUSTOM_OBSERVER="y"  # Custom observer 