# Smartelligent Container Configuration - Selective
# This configuration allows you to choose which supporting containers to customize

# Main components (always custom from Digital-Synapse-SA)
SMARTELLIGENT_CORE_REPO="https://github.com/Digital-Synapse-SA/core.git"
SMARTELLIGENT_FRONTEND_REPO="https://github.com/Digital-Synapse-SA/frontend.git"
SMARTELLIGENT_SUPERVISOR_REPO="https://github.com/Digital-Synapse-SA/supervisor.git"

# Supporting components - SELECTIVE CUSTOMIZATION
# Choose which ones to customize based on your needs

# DNS service - Custom (for custom DNS configuration)
SMARTELLIGENT_USE_CUSTOM_DNS="y"
SMARTELLIGENT_DNS_REPO="https://github.com/Digital-Synapse-SA/dns.git"

# Audio service - Standard (stable audio handling)
SMARTELLIGENT_USE_CUSTOM_AUDIO="n"
SMARTELLIGENT_AUDIO_REPO=""

# CLI tools - Custom (for custom CLI commands)
SMARTELLIGENT_USE_CUSTOM_CLI="y"
SMARTELLIGENT_CLI_REPO="https://github.com/Digital-Synapse-SA/cli.git"

# Multicast discovery - Standard (stable network discovery)
SMARTELLIGENT_USE_CUSTOM_MULTICAST="n"
SMARTELLIGENT_MULTICAST_REPO=""

# System monitoring - Custom (for custom monitoring)
SMARTELLIGENT_USE_CUSTOM_OBSERVER="y"
SMARTELLIGENT_OBSERVER_REPO="https://github.com/Digital-Synapse-SA/observer.git"

# This configuration allows fine-grained control:
# - Customize only the components you need to modify
# - Keep stable components as standard
# - Good for testing specific customizations
# - Easy to modify individual components 